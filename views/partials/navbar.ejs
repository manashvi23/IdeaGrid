<style>
  /* Quick hover effect for the search dropdown items */
  .search-result-item:hover {
    background-color: #343a40;
    transition: background-color 0.2s ease;
  }
</style>

<script>
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  let searchTimeout;

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimeout); // The Debounce: Cancels the previous timer if they keep typing
      const query = this.value.trim();

      // If they delete everything, hide the box instantly
      if (query.length === 0) {
        searchResults.innerHTML = '';
        searchResults.classList.add('d-none');
        return;
      }

      // Wait 300ms after they STOP typing to actually ask the server
      searchTimeout = setTimeout(async () => {
        try {
          const response = await fetch(`/api/search/${query}`);
          const data = await response.json();

          searchResults.innerHTML = ''; // Clear old results

          if (data.success && data.users.length > 0) {
            // Build the HTML for each user found
            data.users.forEach(user => {
              const defaultDp = 'https://placehold.co/40x40/000/FFF?text=DP';
              const resultHTML = `
                <a href="/profile/${user.username}" class="d-flex align-items-center p-2 text-decoration-none text-light border-bottom border-secondary search-result-item">
                  <img src="${user.dp || defaultDp}" style="width: 35px; height: 35px; border-radius: 50%; object-fit: cover; margin-right: 10px;">
                  <span class="fw-bold">${user.username}</span>
                </a>
              `;
              searchResults.insertAdjacentHTML('beforeend', resultHTML);
            });
            searchResults.classList.remove('d-none');
          } else {
            // No users found
            searchResults.innerHTML = '<div class="p-3 text-muted small text-center">No users found</div>';
            searchResults.classList.remove('d-none');
          }
        } catch (error) {
          console.error("Search fetch error:", error);
        }
      }, 300); // 300 milliseconds delay
    });

    // UX Feature: Hide the dropdown if they click anywhere else on the page
    document.addEventListener('click', function(e) {
      if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
        searchResults.classList.add('d-none');
      }
    });
  }
</script>
