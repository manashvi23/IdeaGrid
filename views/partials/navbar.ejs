          <!-- adding search bar -->
          <div class="position-relative mx-3" style="width: 250px; z-index: 1050;">
            <input type="text" id="search-input" class="form-control form-control-sm bg-dark text-light border-secondary rounded-pill px-3" placeholder="Search users..." autocomplete="off">
            
            <div id="search-results" class="position-absolute w-100 bg-dark border border-secondary rounded shadow d-none mt-1" style="top: 100%; left: 0; max-height: 250px; overflow-y: auto;">
