<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feed</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
  <link rel="stylesheet" href="/stylesheets/feed.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container">
    <% posts.forEach(function(elem) { %>
      <div class="box">
        <img src="/images/uploads/<%= elem.image %>" alt="<%= elem.imageText || 'No caption' %>">

        <div class="content-area">
          <p class="caption post-title-caption"><%= elem.imageText || 'No caption' %></p>

          <div class="post-info-actions">
            <p class="caption posted-by-caption">Posted by: <%= elem.user ? elem.user.username : 'Unknown' %></p>
            <div class="download-container">
              <a href="/images/uploads/<%= elem.image %>"
                 download="<%= elem.imageText ? elem.imageText.replace(/[^a-zA-Z0-9]/g, '_') : 'post' %>_by_<%= elem.user ? elem.user.username : 'unknown' %><%= elem.image.substring(elem.image.lastIndexOf('.')) %>"
                 class="custom-download-btn">
                <i class="fas fa-download"></i> Download
              </a>
            </div>
          </div>
          </div>
      </div>
    <% }) %>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
</body>
</html>