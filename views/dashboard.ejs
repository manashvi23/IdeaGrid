<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | Analytics</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-dark text-light" style="min-height: 100vh;">
  
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4 text-center fw-bold">Performance Analytics</h2>

    <div class="row text-center mb-5">
      
      <div class="col-6 col-md-3 mb-3">
        <div class="card bg-secondary text-white border-0 shadow-sm py-3 h-100">
          <h5 class="text-uppercase mb-1" style="font-size: 0.85rem; letter-spacing: 1px;">Current Streak</h5>
          <h2 class="fw-bold mb-0"><%= user.currentStreak || 0 %> <span class="fs-5">🔥</span></h2>
        </div>
      </div>

      <div class="col-6 col-md-3 mb-3">
        <div class="card bg-secondary text-white border-0 shadow-sm py-3 h-100">
          <h5 class="text-uppercase mb-1" style="font-size: 0.85rem; letter-spacing: 1px;">Uploads</h5>
          <h2 class="fw-bold mb-0"><%= totalPosts %></h2>
        </div>
      </div>

      <div class="col-6 col-md-3 mb-3">
        <div class="card bg-secondary text-white border-0 shadow-sm py-3 h-100">
          <h5 class="text-uppercase mb-1" style="font-size: 0.85rem; letter-spacing: 1px;">Saved Posts</h5>
          <h2 class="fw-bold mb-0"><%= totalDownloads %></h2>
        </div>
      </div>

      <div class="col-6 col-md-3 mb-3">
        <div class="card bg-secondary text-white border-0 shadow-sm py-3 h-100">
          <h5 class="text-uppercase mb-1" style="font-size: 0.85rem; letter-spacing: 1px;">Likes Received</h5>
          <h2 class="fw-bold mb-0"><%= totalLikes %></h2>
        </div>
      </div>

    </div>

    <div class="row justify-content-center mb-5">
      <div class="col-md-8 bg-black p-4 rounded border border-secondary shadow">
        <canvas id="engagementChart"></canvas>
      </div>
    </div>
  </div>

  <script>
    const ctx = document.getElementById('engagementChart').getContext('2d');
    
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Uploads', 'Saved Posts', 'Total Likes Received'],
        datasets: [{
          label: 'User Engagement Profile',
          // Injecting your EJS backend variables directly into the graph data!
          data: [<%= totalPosts %>, <%= totalDownloads %>, <%= totalLikes %>],
          backgroundColor: [
            'rgba(13, 202, 240, 0.8)', // Info Blue
            'rgba(25, 135, 84, 0.8)',  // Success Green
            'rgba(220, 53, 69, 0.8)'   // Danger Red
          ],
          borderColor: [
            'rgba(13, 202, 240, 1)',
            'rgba(25, 135, 84, 1)',
            'rgba(220, 53, 69, 1)'
          ],
          borderWidth: 1,
          borderRadius: 6 // Rounds the top of the bars slightly
        }]
      },
      options: {
        responsive: true,
        scales: {
          y: { 
            beginAtZero: true,
            ticks: { color: '#ccc' }, // Light gray text for dark mode
            grid: { color: 'rgba(255, 255, 255, 0.1)' } 
          },
          x: { 
            ticks: { color: '#ccc' },
            grid: { display: false }
          }
        },
        plugins: {
          legend: { labels: { color: '#fff', font: { size: 14 } } }
        }
      }
    });
  </script>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>